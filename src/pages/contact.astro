---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Contact Brad Brondt — Mortgage Loan Officer"
  description="Get in touch with Brad Brondt. Call, email, or connect on social. Serving South Jersey and the Philadelphia suburbs."
>
  <Nav />
  <main>

    <section class="page-hero">
      <div class="container">
        <div class="tag" style="margin-bottom:var(--space-5);">Contact</div>
        <h1 class="page-hero__title">Let's talk.</h1>
        <p class="page-hero__sub">
          Have a question about buying? Want to know if you qualify? 
          Just reach out — I'll give you a straight answer.
        </p>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container">
        <div class="contact-layout">

          <!-- Contact Options -->
          <div class="contact-options">
            <h2>Reach out directly</h2>

            <a href="tel:8564859603" class="contact-card">
              <div class="contact-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.35h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
              </div>
              <div>
                <strong>Call or Text</strong>
                <span>(856) 485-9603</span>
              </div>
              <svg class="contact-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a href="mailto:bbrondt@acremortgage.com" class="contact-card">
              <div class="contact-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <strong>Email</strong>
                <span>bbrondt@acremortgage.com</span>
              </div>
              <svg class="contact-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a href="/webinar" class="contact-card contact-card--accent">
              <div class="contact-card__icon contact-card__icon--accent">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <strong>Join the Free Webinar</strong>
                <span>Best way to start — get your readiness score</span>
              </div>
              <svg class="contact-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <!-- Social links -->
            <div class="contact-social">
              <p class="contact-social__label">Or find me on</p>
              <div class="contact-social__links">
                <a href="https://www.instagram.com/brad_brondt/" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Instagram</a>
                <a href="https://www.facebook.com/bradbrondtmlo" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Facebook</a>
                <a href="https://www.linkedin.com/in/bradbrondt" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">LinkedIn</a>
                <a href="https://www.youtube.com/@TheBrondtCookGroup" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">YouTube</a>
              </div>
            </div>
          </div>

          <!-- FAQ -->
          <div class="faq">
            <h2>Common questions</h2>
            <div class="faq__list">
              <details class="faq__item">
                <summary class="faq__question">What areas do you serve?</summary>
                <p class="faq__answer">I'm licensed in New Jersey and Pennsylvania, primarily serving South Jersey and the Philadelphia suburbs.</p>
              </details>
              <details class="faq__item">
                <summary class="faq__question">Do you work with first-time buyers?</summary>
                <p class="faq__answer">Absolutely — first-time buyers are a big part of what I do. The free webinar is specifically designed for people new to the process.</p>
              </details>
              <details class="faq__item">
                <summary class="faq__question">What loan types do you offer?</summary>
                <p class="faq__answer">FHA, Conventional, VA, DSCR, FHA 203k renovation loans, Fannie Mae Homestyle, HELOCs, and buy-before-you-sell programs.</p>
              </details>
              <details class="faq__item">
                <summary class="faq__question">How quickly can I get pre-approved?</summary>
                <p class="faq__answer">Most pre-approvals happen within 24–48 hours once you've submitted your documents. We can often move faster for motivated buyers.</p>
              </details>
              <details class="faq__item">
                <summary class="faq__question">What if my credit isn't great?</summary>
                <p class="faq__answer">Register for the webinar — I walk through exactly what credit score targets you need for each loan type, and what you can do to improve it. Most people are closer than they think.</p>
              </details>
              <details class="faq__item">
                <summary class="faq__question">Are you a broker or a lender?</summary>
                <p class="faq__answer">I'm a loan officer at Acre Mortgage and Financial Inc. (NMLS #13988), operating as The Brondt Cook Group. We originate and close loans in-house.</p>
              </details>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
.page-hero {
  padding-block: clamp(var(--space-16), 10vw, var(--space-24));
  border-bottom: 1px solid var(--color-border);
  background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
}
.page-hero__title { font-size: var(--text-3xl); font-weight: 900; letter-spacing: -0.04em; margin-bottom: var(--space-5); }
.page-hero__sub { color: var(--color-text-muted); font-size: var(--text-lg); line-height: 1.6; max-width: 500px; }

.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}

.contact-options h2, .faq h2 {
  font-size: var(--text-xl);
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-6);
}

.contact-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.contact-card {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-6);
  background: var(--color-surface-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all var(--transition);
}
.contact-card:hover {
  border-color: rgba(0,212,212,0.3);
  box-shadow: var(--shadow-glow);
}
.contact-card--accent {
  border-color: rgba(0,212,212,0.2);
  background: var(--color-accent-dim);
}

.contact-card__icon {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-accent);
  flex-shrink: 0;
}
.contact-card__icon--accent { background: var(--color-accent); color: var(--color-text-inverse); border-color: transparent; }

.contact-card > div { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.contact-card strong { font-size: var(--text-sm); font-weight: 700; color: var(--color-text); }
.contact-card span { font-size: var(--text-xs); color: var(--color-text-muted); }

.contact-card__arrow { color: var(--color-text-faint); flex-shrink: 0; transition: transform var(--transition); }
.contact-card:hover .contact-card__arrow { transform: translateX(3px); color: var(--color-accent); }

.contact-social { margin-top: var(--space-4); }
.contact-social__label { font-size: var(--text-xs); color: var(--color-text-faint); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-3); }
.contact-social__links { display: flex; flex-wrap: wrap; gap: var(--space-2); }

/* FAQ */
.faq__list { display: flex; flex-direction: column; }
.faq__item {
  border-bottom: 1px solid var(--color-border);
  padding-block: var(--space-5);
}
.faq__item:first-child { border-top: 1px solid var(--color-border); }

.faq__question {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: 700;
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  color: var(--color-text);
  transition: color var(--transition);
}
.faq__question::-webkit-details-marker { display: none; }
.faq__question::after {
  content: '+';
  font-size: var(--text-lg);
  font-weight: 300;
  color: var(--color-text-faint);
  flex-shrink: 0;
  transition: transform var(--transition), color var(--transition);
}
details[open] .faq__question::after { transform: rotate(45deg); color: var(--color-accent); }
.faq__question:hover { color: var(--color-accent); }

.faq__answer {
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  line-height: 1.7;
  padding-top: var(--space-4);
}

@media (max-width: 900px) {
  .contact-layout { grid-template-columns: 1fr; gap: var(--space-12); }
}
</style>
