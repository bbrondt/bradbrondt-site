---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Free Home Buyer Readiness Webinar — Brad Brondt"
  description="Join Brad Brondt's free live Home Buyer Readiness Webinar. Learn exactly what it takes to buy a home in South Jersey and the Philadelphia suburbs — credit, cash, process, and more."
>
  <Nav />
  <main>

    <!-- HERO -->
    <section class="webinar-hero">
      <div class="webinar-hero__glow" aria-hidden="true"></div>
      <div class="container container--narrow">
        <div class="webinar-hero__content">
          <div class="tag" style="margin-bottom:var(--space-5);">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="var(--color-accent)" aria-hidden="true"><circle cx="4" cy="4" r="4"/></svg>
            Free Live Webinar
          </div>
          <h1 class="webinar-hero__title">Home Buyer<br />Readiness Workshop</h1>
          <p class="webinar-hero__sub">
            In one hour, you'll know exactly where you stand — your credit targets, 
            how much cash you need, and the full process from application to keys. 
            No jargon. No pressure. Just answers.
          </p>

          <!-- Registration embed area -->
          <div class="register-block">
            <div class="register-block__inner">
              <p class="register-block__label">Reserve your spot</p>
              <!-- TODO: Replace this div with your actual WebinarFuse / GoTo / Zoom embed code -->
              <div class="register-block__embed" id="webinar-embed">
                <div class="register-block__placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-faint)" stroke-width="1.25" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <strong>Registration form goes here</strong>
                  <span>Paste your WebinarFuse or registration embed code into <code>webinar.astro</code> inside the <code>#webinar-embed</code> div.</span>
                  <a href="#" class="btn btn--primary btn--lg" aria-label="Registration form placeholder">
                    Register Now — It's Free
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
              <p class="register-block__note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                No spam. Your info is never shared or sold. NMLS #242550.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT YOU'LL LEARN -->
    <section class="section learn">
      <div class="container">
        <div class="section-header">
          <div class="tag">What You'll Learn</div>
          <h2 class="section-title">Everything you need to know<br />before you make an offer.</h2>
        </div>

        <div class="learn__grid">
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
            </div>
            <h3>Your credit score — decoded</h3>
            <p>What score you actually need, what's hurting it, and how to move it fast.</p>
          </div>
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3>Cash to close — the real number</h3>
            <p>Down payment, closing costs, reserves — exactly what needs to be in your account.</p>
          </div>
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3>Qualifying — what lenders look at</h3>
            <p>Income, debt ratios, employment history — what matters and what doesn't.</p>
          </div>
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>The full process — start to keys</h3>
            <p>Every step from pre-approval to closing table, explained in plain English.</p>
          </div>
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Is now the right time?</h3>
            <p>Rates, market conditions, and how to think about timing without overthinking it.</p>
          </div>
          <div class="card learn__card">
            <div class="learn__icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            <h3>Your personal readiness score</h3>
            <p>Leave with a clear picture of where you are and exactly what to do next.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO THIS IS FOR -->
    <section class="section--tight for-section">
      <div class="container">
        <div class="for-layout">
          <div>
            <div class="tag" style="margin-bottom:var(--space-5);">Who This Is For</div>
            <h2>You don't need to have<br />it all figured out.</h2>
            <p>This webinar is for anyone who's thinking about buying — whether that's in 30 days or 12 months.</p>
          </div>
          <div class="for-list">
            <div class="for-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>First-time buyers who don't know where to start</span>
            </div>
            <div class="for-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Renters tired of paying someone else's mortgage</span>
            </div>
            <div class="for-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>People who were told "no" and want to know why</span>
            </div>
            <div class="for-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Anyone who wants the real math — not just "you should be fine"</span>
            </div>
            <div class="for-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Move-up buyers wondering if they can afford the next step</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT BRAD (MINI) -->
    <section class="section--tight brad-mini">
      <div class="container container--narrow">
        <div class="card brad-mini__card">
          <div class="brad-mini__photo">
            <!-- TODO: Replace with actual photo -->
            <div class="brad-mini__photo-placeholder" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-faint)" stroke-width="1.25"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
          </div>
          <div>
            <p class="brad-mini__quote">
              "Most people are closer to buying than they think. They just need someone to 
              show them the real numbers — not the runaround."
            </p>
            <p class="brad-mini__name"><strong>Brad Brondt</strong> · NMLS #242550 · Closing loans since 2009</p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
.webinar-hero {
  position: relative;
  padding-block: clamp(var(--space-16), 10vw, var(--space-24));
  background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}
.webinar-hero__glow {
  position: absolute;
  top: -30%;
  right: -10%;
  width: 60%;
  height: 80%;
  background: radial-gradient(ellipse, rgba(0,212,212,0.08) 0%, transparent 65%);
  pointer-events: none;
}
.webinar-hero__content { position: relative; z-index: 1; }
.webinar-hero__title {
  font-size: var(--text-3xl);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 0.95;
  margin-bottom: var(--space-6);
}
.webinar-hero__sub {
  color: var(--color-text-muted);
  font-size: var(--text-lg);
  line-height: 1.6;
  margin-bottom: var(--space-10);
}

.register-block {
  background: var(--color-surface-card);
  border: 1px solid rgba(0,212,212,0.2);
  border-radius: var(--radius-xl);
  padding: clamp(var(--space-6), 4vw, var(--space-10));
  box-shadow: 0 0 40px rgba(0,212,212,0.08);
}
.register-block__inner { display: flex; flex-direction: column; gap: var(--space-5); }
.register-block__label {
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text-faint);
}
.register-block__embed { min-height: 200px; }
.register-block__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  min-height: 200px;
  text-align: center;
  color: var(--color-text-muted);
  border: 2px dashed var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
}
.register-block__placeholder strong { font-size: var(--text-base); color: var(--color-text); }
.register-block__placeholder span { font-size: var(--text-sm); line-height: 1.6; max-width: 380px; }
.register-block__placeholder code {
  background: var(--color-surface);
  padding: 2px 6px;
  border-radius: var(--radius-sm);
  font-size: 0.85em;
  color: var(--color-accent);
}
.register-block__note {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-faint);
}

.section-header { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-12); max-width: 640px; }
.section-title { font-size: var(--text-2xl); font-weight: 900; letter-spacing: -0.03em; line-height: 1.05; }

.learn__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-5); }
.learn__card { display: flex; flex-direction: column; gap: var(--space-4); }
.learn__icon {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-accent-dim);
  color: var(--color-accent);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}
.learn__card h3 { font-size: var(--text-base); font-weight: 700; }
.learn__card p { color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.65; }

.for-section { background: var(--color-surface); border-block: 1px solid var(--color-border); }
.for-layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: center; }
.for-layout h2 { font-size: var(--text-xl); font-weight: 800; letter-spacing: -0.02em; margin-bottom: var(--space-4); }
.for-layout p { color: var(--color-text-muted); font-size: var(--text-base); }
.for-list { display: flex; flex-direction: column; gap: var(--space-4); }
.for-item { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }

.brad-mini__card { display: flex; align-items: center; gap: var(--space-6); }
.brad-mini__photo {
  width: 72px; height: 72px; border-radius: 50%; overflow: hidden;
  background: var(--color-surface); border: 1px solid var(--color-border); flex-shrink: 0;
}
.brad-mini__photo-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.brad-mini__quote { font-style: italic; color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.65; margin-bottom: var(--space-3); }
.brad-mini__name { font-size: var(--text-xs); color: var(--color-text-faint); }

@media (max-width: 700px) {
  .for-layout { grid-template-columns: 1fr; gap: var(--space-8); }
  .brad-mini__card { flex-direction: column; text-align: center; }
}
</style>
